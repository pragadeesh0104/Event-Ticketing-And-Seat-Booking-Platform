erDiagram
    users ||--o{ events : "organizes"
    users ||--o{ bookings : "places"
    users ||--o{ notifications : "receives"
    users ||--o{ audit_logs : "triggers"

    venues ||--o{ events : "hosts"
    venues ||--o{ seats : "contains"

    events ||--o{ bookings : "has"
    events ||--o{ booking_seats : "reserves"

    seats ||--o{ booking_seats : "mapped_in"

    bookings ||--o{ booking_seats : "includes"
    bookings ||--o{ payments : "paid_via"

    booking_seats ||--o| tickets : "issues"

    users {
        bigint id PK
        string full_name
        string email UK
        string password_hash
        string role
        string account_status
        datetime created_at
        datetime updated_at
    }

    venues {
        bigint id PK
        string name
        string address
        string city
        int capacity
        datetime created_at
    }

    events {
        bigint id PK
        bigint organizer_id FK
        bigint venue_id FK
        string title
        text description
        string category
        date event_date
        time start_time
        time end_time
        string banner_url
        string status
        datetime created_at
        datetime updated_at
    }

    seats {
        bigint id PK
        bigint venue_id FK
        string row_label
        string seat_number
        string seat_category
        decimal default_price
        boolean is_active
    }

    bookings {
        bigint id PK
        string booking_reference UK
        bigint user_id FK
        bigint event_id FK
        decimal total_amount
        string booking_status
        datetime booked_at
        datetime expires_at
    }

    booking_seats {
        bigint id PK
        bigint booking_id FK
        bigint event_id FK
        bigint seat_id FK
        decimal seat_price
        string reservation_status
        datetime hold_expires_at
    }

    payments {
        bigint id PK
        bigint booking_id FK
        string transaction_reference UK
        decimal amount
        string payment_method
        string payment_status
        datetime paid_at
        datetime created_at
    }

    tickets {
        bigint id PK
        bigint booking_seat_id FK
        string ticket_reference UK
        string qr_verification_token UK
        string ticket_status
        datetime issued_at
    }

    notifications {
        bigint id PK
        bigint user_id FK
        string title
        string message
        string notification_type
        boolean is_read
        datetime created_at
    }

    audit_logs {
        bigint id PK
        bigint actor_user_id FK
        string action
        string entity_type
        bigint entity_id
        datetime created_at
    }
